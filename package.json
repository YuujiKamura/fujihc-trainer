    "test:e2e": "playwright test",
    "prepare": "bash scripts/install-courtesy-gate-hook.sh || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.55.9",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
